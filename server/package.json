{
  "name": "skillcheck-training-portal-server",
  "version": "1.0.0",
  "description": "Backend API for SkillCheck Training Portal",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --ignore data --ignore uploads --ignore node_modules src/index.js"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "uploads/*",
      "node_modules/*"
    ]
  },
  "dependencies": {
